# Supabase project (same project the backend connects to - Auth only on the
# frontend; all dashboard data comes from the backend API below, never
# directly from Supabase tables, so credentials/integration tokens can never
# reach the browser - see ARCHITECTURE.md in backend/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL (the Fastify service from backend/).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Must match backend's CORS_ALLOWED_ORIGINS in production.
