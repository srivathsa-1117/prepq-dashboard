# ============================================================================
# Server
# ============================================================================
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of origins allowed to call this API (the Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# Supabase
# ============================================================================
# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=
# Anon/public key - used only to validate incoming user JWTs, never for writes
SUPABASE_ANON_KEY=
# Service role key - server-side only, full DB access, NEVER expose to a browser
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret for verifying Supabase Auth access tokens locally without a network call
# (Project Settings -> API -> JWT Settings). Optional if SUPABASE_URL verification is used instead.
SUPABASE_JWT_SECRET=

# ============================================================================
# Credential encryption
# ============================================================================
# 32-byte key, base64-encoded, used to encrypt integration OAuth tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_CREDENTIALS_ENC_KEY=

# ============================================================================
# Meta (Facebook) Marketing API
# ============================================================================
# TODO(meta): confirm final app review status / permissions granted (ads_read, ads_management)
META_APP_ID=
META_APP_SECRET=
# Graph API version pin, e.g. v20.0 - bump deliberately, Meta deprecates versions on a schedule
META_GRAPH_API_VERSION=v20.0
META_OAUTH_REDIRECT_URI=
# V1: single-tenant deployment reports on exactly one Meta ad account, so connect auto-finalizes
# to this id (no account picker). Leave blank to fall back to the picker flow.
META_DEFAULT_AD_ACCOUNT_ID=
# Alternative to the OAuth app above: a Business Settings > System Users > Generate New Token
# access token, which can be set to never expire and skips the OAuth consent screen entirely.
# NOT read directly by the app (no code path consumes this var) - it's a reference slot to paste
# into the Integrations drawer's Meta "Connect with token" field, which calls
# POST /api/integrations/meta/connect with { api_key: <token>, external_account_id }.
META_SYSTEM_USER_ACCESS_TOKEN=

# ============================================================================
# Google Ads API
# ============================================================================
# TODO(google): developer token is account-level and requires Google's approval for
# "Standard" access before it can read accounts you don't own (agency use case).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REDIRECT_URI=
# Manager (MCC) customer id, digits only, no dashes - required to call on behalf of client accounts
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
# Same V1 single-account simplification as META_DEFAULT_AD_ACCOUNT_ID above.
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=

# ============================================================================
# Meritto CRM
# ============================================================================
# TODO(meritto): base URL and auth scheme are account-specific - confirm with Meritto's
# account manager / developer portal (https://www.meritto.com/developer-portal/) before go-live.
# Meritto historically issues a per-account API key + secret pair (header-based auth),
# NOT a standard OAuth2 flow. Do not assume OAuth without confirming.
MERITTO_API_BASE_URL=
MERITTO_API_KEY=
MERITTO_API_SECRET=
# Shared secret used to verify inbound Meritto webhook signatures, if/when webhooks are enabled.
MERITTO_WEBHOOK_SECRET=

# ============================================================================
# Misc
# ============================================================================
# Scheduled sync jobs run in-process (see src/scheduler/syncScheduler.ts) - no external
# scheduler service or credentials needed.
INTERNAL_SERVICE_SECRET=
